{
  "name": "ride-matching-server",
  "version": "1.0.0",
  "description": "Express backend for Ride Matching App",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch index.ts",
    "build": "npx prisma generate --schema=../database/schema.prisma && tsc",
    "start": "node dist/index.js",
    "db:migrate": "npx dotenv -e ../.env -- prisma migrate deploy --schema=../database/schema.prisma",
    "db:generate": "npx dotenv -e ../.env -- prisma generate --schema=../database/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "dotenv-cli": "^11.0.0",
    "prisma": "^6.19.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
