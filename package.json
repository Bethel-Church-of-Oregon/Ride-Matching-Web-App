{
  "name": "ride-matching-web-app",
  "version": "1.0.0",
  "description": "A TypeScript web application for ride matching",
  "type": "module",
  "workspaces": [
    "backend-dev"
  ],
  "prisma": {
    "schema": "database/schema.prisma"
  },
  "scripts": {
    "dev": "vite",
    "dev:backend": "npm run dev --workspace=backend-dev",
    "build": "npx prisma generate && npm run build --workspace=backend-dev && tsc && vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "db:migrate": "npx dotenv -e .env -- prisma migrate deploy",
    "db:generate": "npx prisma generate",
    "db:migrate:dev": "npx dotenv -e .env -- prisma migrate dev",
    "vercel-build": "npx prisma generate && npm run build"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^20.10.0",
    "@vercel/node": "^3.0.0",
    "dotenv-cli": "^11.0.0",
    "prisma": "^6.19.0",
    "typescript": "^5.3.3",
    "vite": "^7.2.1"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "bcrypt": "^5.1.1"
  }
}
